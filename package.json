{
  "name": "scriptman-fighters",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "description": "A fighting game where you write JavaScript to control AI fighters. UI powered by Vanduo UI (vd3) for Vue 3.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@vanduo-oss/vd3": "^1.2.2",
    "@vanduo-oss/vd3-cbun": "^1.3.1",
    "@vueuse/core": "^14.4.0",
    "acorn": "^8.18.0",
    "vue": "^3.5.41",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "latest",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.28.2"
}
