{
  "name": "scriptman-fighters",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "A fighting game where you write JavaScript to control AI fighters. UI powered by Vanduo UI (vd3) for Vue 3.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@vanduo-oss/vd3": "^1.1.0",
    "@vanduo-oss/vd3-cbun": "^1.2.0",
    "@vueuse/core": "^14.2.0",
    "acorn": "^8.18.0",
    "vue": "^3.5.40",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "latest",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "~5.8.3",
    "vite": "^8.1.4",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.8"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.28.2"
}
